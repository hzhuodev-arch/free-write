{
  "include": ["**/*.ts", "**/*.tsx", "convex/shared/**/*.ts"],
  "exclude": [
    "convex/_generated",
    "convex/api",
    "convex/llm",
    "convex/services",
    "convex/schema.ts",
    "repos",
    "vendor"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@convex/*": ["./convex/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Effect language service plugin */
    "plugins": [{ "name": "@effect/language-service" }]
  }
}
